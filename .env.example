# Copy to .env.local and fill in from `pnpm supabase status` after `pnpm db:start`.
# .env.local is git-ignored. Never commit real keys.

# Local Supabase API (Kong gateway)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# "Publishable key" from `supabase status`. Safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# "Secret key" from `supabase status`. Server-only: bypasses RLS.
# Used solely by src/lib/supabase/admin.ts to write XP and unlocks.
SUPABASE_SECRET_KEY=
